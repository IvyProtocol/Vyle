$FONT_NAME = <GTK_FONT_NAME>
$FONT_ANTIALIASING = <GTK_FONT_ANTIALIASING>
$FONT_HINTING = <GTK_FONT_HINTING>
$FONT_SIZE = <GTK_FONT_SIZE>
$DOCUMENT_FONT = <GTK_DOCUMENT_FONT>
$DOCUMENT_FONT_SIZE = <GTK_DOCUMENT_FONT_SIZE>
$MONOSPACE_FONT = <GTK_MONOSPACE_FONT>
$MONOSPACE_FONT_SIZE = <GTK_MONOSPACE_FONT_SIZE>

